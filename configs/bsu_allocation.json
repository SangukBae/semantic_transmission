{
  "model": {
    "feature_dim": 71,
    "hidden": 256,
    "heads": 4,
    "temporal_layers": 3,
    "candidate_layers": 2,
    "metrics": 3,
    "dropout": 0.1,
    "gated": true
  },
  "objective": {
    "metric_names": ["psnr_db", "lpips_vgg", "flow_error_mean"],
    "scales": [1.0, 0.02, 0.1],
    "weights": [1.0, 1.0, 0.5],
    "regression_weight": 1.0,
    "ranking_weight": 1.0,
    "regret_weight": 1.0,
    "temperature": 0.5
  },
  "training": {
    "seed": 2025,
    "max_steps": 1000,
    "batch_size": 4,
    "learning_rate": 0.0002,
    "weight_decay": 0.01,
    "warmup_steps": 25,
    "save_every": 25,
    "validate_every": 50,
    "gradient_clip": 1.0,
    "cpu_threads": 2
  },
  "adopt_as_default": false
}
